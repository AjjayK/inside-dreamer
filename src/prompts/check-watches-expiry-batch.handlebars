{{#each watches}}
## Watch #{{this.id}}
- Description: {{this.description}}
- Topics: {{this.topics}}
- Created: {{this.createdAt}}
{{#if this.recentAlerts.length}}
- Recent alerts:
{{#each this.recentAlerts}}
  - "{{this.title}}" ({{this.sourceName}}, {{this.createdAt}})
{{/each}}
{{else}}
